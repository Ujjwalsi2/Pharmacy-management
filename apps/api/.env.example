# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/meditrack

# JWT secrets (minimum 32 characters — generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string

# Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-frontend.vercel.app
TRUST_PROXY=true

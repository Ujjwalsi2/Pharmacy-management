# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file, relative to apps/api)
DATABASE_URL="file:./dev.db"

# JWT secrets - MUST be overridden with strong random values in production.
# The app refuses to start in production with these placeholder values.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS - the origin of the web app
CORS_ORIGIN=http://localhost:5173
